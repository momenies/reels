# ── Required by pipeline/score.py ──────────────────────────────────────────
# https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ── Optional: everything below has a working default ───────────────────────
# Clip selection model
# REELS_MODEL=claude-sonnet-5

# Transcription. small/medium on CPU, large-v3 on a GPU box.
# REELS_WHISPER_MODEL=small
# REELS_DEVICE=cpu              # cpu | cuda
# REELS_COMPUTE_TYPE=           # blank = int8 on cpu, float16 on cuda

# Rendering
# REELS_GPU=0                   # 1 = NVENC encoding
# REELS_CRF=20                  # lower is better quality, bigger files
# REELS_RENDER_WORKERS=0        # 0 = auto (half your cores, capped at 4)
# REELS_LOUDNORM=1              # match the loudness platforms normalise to

# Face tracking
# REELS_SAMPLE_FPS=4
# REELS_DETECT_WIDTH=640        # detection runs on a downscaled copy

# Server
# REELS_DATA_DIR=./data
# REELS_JOB_WORKERS=1           # concurrent jobs; each one is a whole video
# REELS_MAX_UPLOAD_MB=2048
# REELS_RETENTION_HOURS=72      # finished jobs and their media are swept after this
# REELS_API_KEY=                # set it and every /api route needs X-API-Key
# REELS_LOG_LEVEL=INFO
